APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# career-toolkit is local-first: Job Analysis and Job Match both default
# to the local Ollama provider below, and the happy path does not
# require an OpenAI API key. OpenAI remains fully supported as an
# explicitly selectable provider (a benchmark/reference path) — set the
# relevant AI_*_PROVIDER var to "openai" and provide OPENAI_API_KEY to
# use it for that purpose. Resume Selection and Resume Wording still
# always use OpenAI (no local implementation exists yet for those two).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Controls the local Ollama provider (OpenAI-compatible Chat
# Completions endpoint) — the local-first default for Job Analysis and
# Job Match. Leave OLLAMA_BASE_URL unset to disable it (any purpose
# still configured to use "ollama" will then fail fast at resolution
# time, not silently fall back to OpenAI). No API key is needed.
# OLLAMA_MODEL/OLLAMA_TIMEOUT_SECONDS are Job Analysis's settings;
# OLLAMA_JOB_MATCH_MODEL/OLLAMA_JOB_MATCH_TIMEOUT_SECONDS are Job
# Match's own, separate settings, so evaluating a different local model
# for one purpose never silently changes the other. qwen3.8:27b is the
# current validated local model for both — a configuration default,
# not an architectural dependency.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_JOB_MATCH_MODEL=qwen3.8:27b
OLLAMA_JOB_MATCH_TIMEOUT_SECONDS=600

# Which provider implementation each purpose uses: openai or ollama.
# Both default to ollama (local-first). Setting either to ollama also
# requires OLLAMA_BASE_URL above. Never an automatic fallback between
# the two in either direction — an unrecognized value fails fast.
AI_JOB_ANALYSIS_PROVIDER=ollama
AI_JOB_MATCH_PROVIDER=ollama

VITE_APP_NAME="${APP_NAME}"
