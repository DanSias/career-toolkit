APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# 7200s (2h) margin over the worst-case legitimate generation job —
# Resume generation's Selection+Wording, each up to 900s x 3 HTTP
# attempts if every attempt hits a retryable transient failure, back
# to back: 2 x (3 x 900 + 2) = 5404s. See config/queue.php.
DB_QUEUE_RETRY_AFTER=7200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# career-toolkit is local-first: Job Analysis, Job Match, Resume
# Selection, and Resume Wording all default to the local Ollama
# provider below, and the happy path does not require an OpenAI API
# key. OpenAI remains fully supported as an explicitly selectable
# provider (a benchmark/reference path) — set the relevant
# AI_*_PROVIDER var to "openai" and provide OPENAI_API_KEY to use it
# for that purpose.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Controls the local Ollama provider (OpenAI-compatible Chat
# Completions endpoint) — the local-first default for Job Analysis, Job
# Match, Resume Selection, and Resume Wording. Leave OLLAMA_BASE_URL
# unset to disable it (any purpose still configured to use "ollama"
# will then fail fast at resolution time, not silently fall back to
# OpenAI). No API key is needed. OLLAMA_MODEL/OLLAMA_TIMEOUT_SECONDS
# are Job Analysis's settings; each other purpose has its own separate
# *_MODEL/*_TIMEOUT_SECONDS pair, so evaluating a different local model
# for one purpose never silently changes the others. qwen3.8:27b is the
# current validated local model for all four — a configuration default,
# not an architectural dependency.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_JOB_MATCH_MODEL=qwen3.8:27b
OLLAMA_JOB_MATCH_TIMEOUT_SECONDS=600
OLLAMA_RESUME_SELECTION_MODEL=qwen3.8:27b
OLLAMA_RESUME_SELECTION_TIMEOUT_SECONDS=900
OLLAMA_RESUME_WORDING_MODEL=qwen3.8:27b
OLLAMA_RESUME_WORDING_TIMEOUT_SECONDS=900

# Which provider implementation each purpose uses: openai or ollama.
# All four default to ollama (local-first). Setting any to ollama also
# requires OLLAMA_BASE_URL above. Never an automatic fallback between
# the two in either direction — an unrecognized value fails fast.
AI_JOB_ANALYSIS_PROVIDER=ollama
AI_JOB_MATCH_PROVIDER=ollama
AI_RESUME_SELECTION_PROVIDER=ollama
AI_RESUME_WORDING_PROVIDER=ollama

# Shared-secret Bearer token the browser-inspector worker (see
# workers/browser-inspector/) authenticates its API calls with — a
# long, random string, never committed with a real value. Leaving this
# blank fails closed: every worker-protocol request is rejected, not
# silently accepted.
BROWSER_WORKER_TOKEN=
BROWSER_WORKER_CLAIM_TTL=60

# Career Toolkit's own expectation of the worker's poll cadence, in
# seconds — must match BROWSER_WORKER_POLL_INTERVAL_MS/1000 on the
# worker side. Used only to derive the online/offline threshold shown
# in the UI (last_seen_at within 3x this value = online).
BROWSER_WORKER_POLL_INTERVAL_SECONDS=5

# Lets the AI-box browser worker reach this app's normal dev server
# over the LAN — see workers/browser-inspector/README.md "Normal
# development connectivity". Uncomment during normal development if a
# persistent worker is deployed; leave unset for 127.0.0.1-only.
# SERVER_HOST=0.0.0.0

# Automatic job discovery (App\Support\JobDiscovery) — see
# docs/job-discovery.md. Himalayas needs no credentials. Adzuna's are
# free at developer.adzuna.com; leaving them blank fails only Adzuna's
# discovery attempt closed, never Himalayas or the app as a whole.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

VITE_APP_NAME="${APP_NAME}"