# Copied to .env on the deployment host (e.g. the AI box) and filled
# in with real values — .env is gitignored and never committed. See
# README.md "Persistent deployment (normal operation)".

# Career Toolkit's normal dev server, reachable from this host over the
# LAN — see the main repository's README/.env.example "Normal
# development connectivity" (SERVER_HOST). Example:
CAREER_TOOLKIT_URL=http://192.168.1.114:8000

# Must match Career Toolkit's BROWSER_WORKER_TOKEN exactly.
BROWSER_WORKER_TOKEN=

# A stable, clearly-named identity for this deployment — shown in
# Career Toolkit's worker-presence badge and AgentRun.worker_identity.
BROWSER_WORKER_IDENTITY=ai-box-browser-inspector

# Optional — defaults shown. Must stay compatible with Career
# Toolkit's own BROWSER_WORKER_POLL_INTERVAL_SECONDS (that value in
# seconds should equal this one in milliseconds / 1000) so the
# online/offline threshold it derives stays meaningful.
BROWSER_WORKER_POLL_INTERVAL_MS=5000
BROWSER_WORKER_MAX_BACKOFF_MS=60000
BROWSER_WORKER_RESULT_RETRY_ATTEMPTS=3
BROWSER_WORKER_RESULT_RETRY_BACKOFF_MS=2000
